@{
    ViewData["Title"] = "Server Monitor";
    Layout = "_Layout";
}

@model ServerMonitor.Core.Models.ServerMetrics

<div class="dashboard">
    <!-- Compact Header -->
    <div class="header">
        <div class="header-left">
            <h1>🖥️ @ViewBag.ProviderName</h1>
            <span class="status-badge online" id="systemStatus"><span class="status-dot">●</span> Online</span>
        </div>
        <div class="update-info">
            <span id="lastUpdate">Loading...</span>
            <span class="refresh-interval">• 5s refresh</span>
        </div>
    </div>

    <!-- Quick Stats Bar - Super Compact -->
    <div class="quick-stats">
        <div class="quick-stat temp-stat">
            <div class="quick-label">Max Temp</div>
            <div class="quick-value" id="maxTemp">--°C</div>
            <div class="quick-indicator" id="tempIndicator"></div>
        </div>
        <div class="quick-stat fan-stat">
            <div class="quick-label">Fans</div>
            <div class="quick-value" id="avgRpm">-- RPM</div>
            <div class="quick-sub" id="fanCount">0 fans</div>
        </div>
        <div class="quick-stat power-stat">
            <div class="quick-label">Power</div>
            <div class="quick-value" id="totalPower">-- W</div>
            <div class="quick-sub" id="powerSource">Loading</div>
        </div>
        <div class="quick-stat mode-stat">
            <div class="quick-label">Mode</div>
            <div class="quick-value" id="controlMode">--</div>
            <div class="quick-sub" id="controlModeDetail">Manual</div>
        </div>
    </div>

    <!-- Message -->
    <div id="message" class="message"></div>

    <!-- Main Content Grid -->
    <div class="content-grid">
        <!-- CPU Section -->
        <div class="section-card">
            <div class="section-title">
                <span class="section-icon">🖥️</span>
                <span class="section-name">CPU Temperatures</span>
                <span class="item-count" id="cpuCoreCount">0</span>
            </div>
            <div class="section-content">
                <div class="cores-container" id="cpuCoresGrid">
                    <div class="loading">Loading...</div>
                </div>
            </div>
        </div>

        <!-- Sensors Section -->
        <div class="section-card">
            <div class="section-title">
                <span class="section-icon">🌡️</span>
                <span class="section-name">Temperature Sensors</span>
                <span class="item-count" id="sensorCount">0</span>
            </div>
            <div class="section-content">
                <div class="sensors-container" id="sensorsGrid">
                    <div class="loading">Loading...</div>
                </div>
            </div>
        </div>

        <!-- GPUs Section -->
        <div class="section-card gpu-section" id="gpuSection" style="display: none;">
            <div class="section-title">
                <span class="section-icon">🎮</span>
                <span class="section-name">GPU Temperatures</span>
                <span class="item-count" id="gpuCount">0</span>
            </div>
            <div class="section-content">
                <div class="gpus-container" id="gpusGrid"></div>
            </div>
        </div>
    </div>

    <!-- Compact Charts -->
    <div class="charts-container" id="chartsContainer">
        <div class="chart-card">
            <div class="chart-title">📊 Temperature</div>
            <div class="chart-wrap"><canvas id="tempChart"></canvas></div>
        </div>
        <div class="chart-card">
            <div class="chart-title">📊 Fans</div>
            <div class="chart-wrap"><canvas id="fanChart"></canvas></div>
        </div>
        <div class="chart-card">
            <div class="chart-title">📊 Power</div>
            <div class="chart-wrap"><canvas id="powerChart"></canvas></div>
        </div>
    </div>

    <!-- Fans List -->
    <div class="section-card">
        <div class="section-title">
            <span class="section-icon">💨</span>
            <span class="section-name">Fan Speeds</span>
            <span class="item-count" id="fanListCount">0</span>
        </div>
        <div class="section-content">
            <div class="fans-grid" id="fansGrid">
                <div class="loading">Loading...</div>
            </div>
        </div>
    </div>

    <!-- Controls -->
    <div class="controls-card">
        <div class="section-title">
            <span class="section-icon">🎛️</span>
            <span class="section-name">Fan Control</span>
        </div>
        <div class="controls-content">
            <button class="btn btn-primary" onclick="restoreDynamic()">🔄 Auto (Dynamic)</button>
            <div class="speed-buttons">
                <button class="speed-btn" data-speed="10">10%</button>
                <button class="speed-btn" data-speed="15">15%</button>
                <button class="speed-btn" data-speed="20">20%</button>
                <button class="speed-btn" data-speed="25">25%</button>
                <button class="speed-btn" data-speed="35">35%</button>
                <button class="speed-btn" data-speed="50">50%</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/site.js"></script>
<script>
    // Chart.js loading (local /js/chart.js first, CDN fallback) lives in site.js
    async function bootCharts() {
        const hasChart = await Site.loadChartJS();
        if (!hasChart) {
            document.getElementById('chartsContainer').style.display = 'none';
            return;
        }
        initCharts();
        await seedCharts();
    }

    // Fill charts from persisted history so they are useful immediately,
    // not only after minutes of live ticks.
    async function seedCharts() {
        try {
            const resp = await fetch('/api/history?hours=1&limit=60');
            if (!resp.ok) return;
            const pts = await resp.json();
            if (!pts.length) return;
            const labels = pts.map(p => Site.fmtTime(p.timestamp));
            Site.setChartData(tempChart, labels, pts.map(p => p.maxTemp));
            Site.setChartData(fanChart, labels, pts.map(p => p.avgRpm));
            Site.setChartData(powerChart, labels, pts.map(p => p.powerWatts));
        } catch (e) {
            console.warn('Chart seeding failed, live data will fill in', e);
        }
    }

    // Global chart instances
    let tempChart, fanChart, powerChart;
    let refreshInterval;
    const maxDataPoints = 60;

    async function initDashboard() {
        await bootCharts();
        await updateDashboard();
        startAutoRefresh();
    }

    function initCharts() {
        tempChart = Site.lineChart(document.getElementById('tempChart'), {
            color: '#ef4444',
            tooltip: { label: c => ` ${c.parsed.y.toFixed(1)}°C` }
        });
        fanChart = Site.lineChart(document.getElementById('fanChart'), {
            color: '#3b82f6',
            tooltip: { label: c => ` ${Math.round(c.parsed.y).toLocaleString()} RPM` }
        });
        powerChart = Site.lineChart(document.getElementById('powerChart'), {
            color: '#f59e0b',
            tooltip: { label: c => ` ${c.parsed.y.toFixed(1)} W` }
        });
        [tempChart, fanChart, powerChart].forEach(c => { if (c) c.$maxPoints = maxDataPoints; });



    }

    function startAutoRefresh() {
        if (refreshInterval) clearInterval(refreshInterval);
        refreshInterval = setInterval(updateDashboard, 5000);
    }

    async function updateDashboard() {
        try {
            const response = await fetch('/api/status');
            
            // Try to parse response even if status is not OK
            let data = null;
            try {
                data = await response.json();
            } catch (e) {
                console.error('Failed to parse response:', e);
                updateConnectionStatus(false);
                clearDashboardData();
                showMessage('❌ Invalid response from server', 'error');
                return;
            }

            // Check if server is connected to hardware
            if (!data.isConnected) {
                updateConnectionStatus(false);
                clearDashboardData();
                showMessage('❌ Server is not connected to hardware', 'error');
                return;
            }

            // Update connection status
            updateConnectionStatus(true);

            // Update time
            const time = new Date(data.timestamp);
            document.getElementById('lastUpdate').textContent = time.toLocaleTimeString();

            // Quick stats - new ServerMetrics shape
            const maxTemp = data.maxTemperature || 0;
            const avgRpm = data.averageRpm || 0;
            const power = data.power || { totalWatts: 0, source: 'N/A' };
            const totalWatts = power.totalWatts || 0;

            document.getElementById('maxTemp').textContent = maxTemp.toFixed(1) + '°C';
            document.getElementById('avgRpm').textContent = avgRpm + ' RPM';
            document.getElementById('fanCount').textContent = (data.fans || []).length + ' fans';
            document.getElementById('totalPower').textContent = totalWatts.toFixed(1) + ' W';
            document.getElementById('powerSource').textContent = power.source || 'N/A';
            document.getElementById('controlMode').textContent = data.currentMode || 'Unknown';
            document.getElementById('controlModeDetail').textContent = data.overallHealth || '--';

            // Temperature indicator
            const tempIndicator = document.getElementById('tempIndicator');
            if (maxTemp < 40) {
                tempIndicator.className = 'quick-indicator good';
            } else if (maxTemp < 50) {
                tempIndicator.className = 'quick-indicator warning';
            } else {
                tempIndicator.className = 'quick-indicator bad';
            }

            // Update sections (mapped to new model shape)
            updateCpuCores(data.cpuCores || []);
            updateSensors(data.temperatures || []);
            updateGpus(data.gpus || []);
            updateFans(data.fans || []);

            // Update charts (no-op when Chart.js failed to load)
            Site.pushChartPoint(tempChart, Site.fmtTime(data.timestamp), maxTemp);
            Site.pushChartPoint(fanChart, Site.fmtTime(data.timestamp), avgRpm);
            Site.pushChartPoint(powerChart, Site.fmtTime(data.timestamp), totalWatts);

        } catch (error) {
            console.error('Update failed:', error);
            updateConnectionStatus(false);
            clearDashboardData();
            showMessage('❌ Server connection lost', 'error');
        }
    }

    function updateConnectionStatus(isConnected) {
        const badge = document.getElementById('systemStatus');
        if (isConnected) {
            badge.className = 'status-badge online';
            badge.innerHTML = '<span class="status-dot">●</span> Online';
        } else {
            badge.className = 'status-badge offline';
            badge.innerHTML = '<span class="status-dot">●</span> Offline';
        }
    }

    function clearDashboardData() {
        // Clear quick stats
        document.getElementById('maxTemp').textContent = '--°C';
        document.getElementById('avgRpm').textContent = '-- RPM';
        document.getElementById('fanCount').textContent = '0 fans';
        document.getElementById('totalPower').textContent = '-- W';
        document.getElementById('powerSource').textContent = 'Offline';
        document.getElementById('controlMode').textContent = '--';
        document.getElementById('controlModeDetail').textContent = 'Disconnected';

        // Clear temperature indicator
        document.getElementById('tempIndicator').className = 'quick-indicator';

        // Clear all sections
        document.getElementById('cpuCoresGrid').innerHTML = '<div class="no-data">Server offline</div>';
        document.getElementById('sensorsGrid').innerHTML = '<div class="no-data">Server offline</div>';
        document.getElementById('fansGrid').innerHTML = '<div class="no-data">Server offline</div>';
        document.getElementById('gpuSection').style.display = 'none';

        // Update time to show last attempt
        document.getElementById('lastUpdate').textContent = new Date().toLocaleTimeString();
    }

    function updateCpuCores(cores) {
        const grid = document.getElementById('cpuCoresGrid');
        document.getElementById('cpuCoreCount').textContent = cores.length;

        if (cores.length === 0) {
            grid.innerHTML = '<div class="no-data">No data</div>';
            return;
        }

        grid.innerHTML = cores.map(core => {
            const temp = core.value || 0;
            const status = temp < 45 ? 'good' : temp < 55 ? 'warning' : 'bad';
            const width = Math.min((temp / 90) * 100, 100);
            return `
                <div class="core-item ${core.isPackage ? 'package' : ''}">
                    <div class="core-name">${core.name}</div>
                    <div class="core-bar-bg"><div class="core-bar ${status}" style="width: ${width}%"></div></div>
                    <div class="core-temp ${status}">${temp.toFixed(1)}°C</div>
                </div>
            `;
        }).join('');
    }

    function updateSensors(sensors) {
        const grid = document.getElementById('sensorsGrid');
        document.getElementById('sensorCount').textContent = sensors.length;

        if (sensors.length === 0) {
            grid.innerHTML = '<div class="no-data">No data</div>';
            return;
        }

        grid.innerHTML = sensors.map(s => {
            const temp = s.value || 0;
            const status = temp < 40 ? 'good' : temp < 50 ? 'warning' : 'bad';
            const width = Math.min((temp / 90) * 100, 100);
            return `
                <div class="sensor-item">
                    <div class="sensor-name">${s.name}</div>
                    <div class="sensor-bar-bg"><div class="sensor-bar ${status}" style="width: ${width}%"></div></div>
                    <div class="sensor-temp ${status}">${temp.toFixed(1)}°C</div>
                </div>
            `;
        }).join('');
    }

    function updateGpus(gpus) {
        const section = document.getElementById('gpuSection');
        const grid = document.getElementById('gpusGrid');
        document.getElementById('gpuCount').textContent = gpus.length;

        if (gpus.length === 0) {
            section.style.display = 'none';
            return;
        }

        section.style.display = 'block';
        grid.innerHTML = gpus.map(gpu => {
            const temp = gpu.temperature || 0;
            const status = temp < 60 ? 'good' : temp < 75 ? 'warning' : 'bad';
            const width = Math.min(temp, 100);
            return `
                <div class="gpu-item">
                    <div class="gpu-name">${gpu.name}</div>
                    <div class="gpu-bar-bg"><div class="gpu-bar ${status}" style="width: ${width}%"></div></div>
                    <div class="gpu-temp ${status}">${temp.toFixed(1)}°C</div>
                    ${gpu.fanSpeedPercent ? `<div class="gpu-fan">💨 ${gpu.fanSpeedPercent}%</div>` : ''}
                </div>
            `;
        }).join('');
    }

    function updateFans(fans) {
        const grid = document.getElementById('fansGrid');
        document.getElementById('fanListCount').textContent = fans.length;

        if (fans.length === 0) {
            grid.innerHTML = '<div class="no-data">No data</div>';
            return;
        }

        grid.innerHTML = fans.map(fan => {
            const width = Math.min((fan.rpm / 20000) * 100, 100);
            return `
                <div class="fan-item">
                    <div class="fan-name">${fan.name}</div>
                    <div class="fan-bar-bg"><div class="fan-bar" style="width: ${width}%"></div></div>
                    <div class="fan-rpm">${fan.rpm}</div>
                </div>
            `;
        }).join('');
    }

    // Live chart updates now go through Site.pushChartPoint (see updateDashboard).





    async function setSpeed(speed) {
        try {
            const response = await fetch(`/api/fans/speed/${speed}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const ok = response.ok;
            const result = await response.json();
            showMessage(ok ? `✓ Fan at ${speed}%` : '✖ ' + (result.error || 'Failed'), ok ? 'success' : 'error');
            if (ok) updateDashboard();
        } catch {
            showMessage('✖ Failed', 'error');
        }
    }

    async function restoreDynamic() {
        try {
            const response = await fetch('/api/fans/auto', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const ok = response.ok;
            const result = await response.json();
            showMessage(ok ? '✓ Auto mode' : '✖ ' + (result.error || 'Failed'), ok ? 'success' : 'error');
            if (ok) updateDashboard();
        } catch {
            showMessage('✖ Failed', 'error');
        }
    }

    function showMessage(text, type) {
        const msg = document.getElementById('message');
        msg.textContent = text;
        msg.className = 'message ' + type;
        setTimeout(() => msg.className = 'message', 3000);
    }

    // Speed button handlers
    document.addEventListener('click', (e) => {
        if (e.target.classList.contains('speed-btn')) {
            setSpeed(parseInt(e.target.dataset.speed));
        }
    });

    // Start loading
    initDashboard();
</script>