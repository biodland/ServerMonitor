{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ServerMonitor": {
    "Server": {
      "Port": 1080
    },
    "Ipmi": {
      "UseLocal": true,
      "Host": "127.0.0.1",
      "Username": "",
      "Password": "",
      "Interface": "lanplus",
      "CipherSuite": 3
    },
    "FanControl": {
      "EnableControl": false,
      "ManualSpeed": 20,
      "CheckIntervalSeconds": 30
    },
    "Updates": {
      "CheckEnabled": true,
      "ReportUsage": false,
      "Channel": "stable"
    },
    "ForceProvider": "",
    "Storage": {
      "Enabled": true,
      "Path": "data/history.db",
      "RetentionDays": 30,
      "WriteIntervalSeconds": 60,
      "MaxQueryPoints": 5000
    },
    "Stats": {
      "Network": {
        "Include": [],
        "Exclude": ["lo", "veth*", "br-*", "docker*", "virbr*", "vnet*", "tun*", "tap*", "wg*"]
      }
    }
  }
}
